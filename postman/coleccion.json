{
  "info": {
    "name": "BiblioTech API",
    "description": "Pruebas de la API de BiblioTech: libros, estudiantes y préstamos, con casos de error. Se ejecuta con Newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('sufijo')) {",
          "    pm.collectionVariables.set('sufijo', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "sufijo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Libros",
      "item": [
        {
          "name": "1. GET /api/libros lista los libros",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('El cuerpo es una lista', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "libros"
              ]
            }
          }
        },
        {
          "name": "2. POST /api/libros registra un libro (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('El libro queda DISPONIBLE con su id', function () {",
                  "    const libro = pm.response.json();",
                  "    pm.expect(libro.id).to.be.a('number');",
                  "    pm.expect(libro.estado).to.eql('DISPONIBLE');",
                  "    pm.expect(libro.ejemplaresDisponibles).to.eql(5);",
                  "    pm.collectionVariables.set('libroId', libro.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/libros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "libros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"ISBN-PM-{{sufijo}}\",\n  \"titulo\": \"Libro Postman {{sufijo}}\",\n  \"autor\": \"Autor Postman\",\n  \"ejemplaresDisponibles\": 5\n}"
            }
          }
        },
        {
